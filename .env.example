# Leave these blank to run the app with the clear "integration not configured" state.
# Tavily is the built-in real search adapter. Obtain a key from Tavily and keep it local.
RESEARCH_PROVIDER=tavily
TAVILY_API_KEY=
TAVILY_API_URL=https://api.tavily.com/search

# Optional alternative for an approved OpenAI-compatible/internal JSON endpoint.
# Set RESEARCH_PROVIDER=http and provide both values instead.
RESEARCH_API_URL=
RESEARCH_API_KEY=
